# Публичный адрес клиента (HTTPS-туннель или ваш домен). QR и ссылки для жюри берутся отсюда,
# если ведущий открыт на localhost.
# PUBLIC_ORIGIN=https://your-subdomain.trycloudflare.com

# Опционально то же для Vite на старте (до загрузки /api/link-base):
# VITE_PUBLIC_ORIGIN=https://your-subdomain.trycloudflare.com